# Local development only
WEB_PORT=5173
PORT=8787

# Supabase database. Keep the transaction pooler URL server-side.
WILDHATCH_DATABASE_URL=
# Database root certificate from Supabase. Use PEM text or escaped newlines.
WILDHATCH_DATABASE_CA=

# Supabase Realtime. Use the project URL and its sb_publishable_ key.
WILDHATCH_SUPABASE_URL=
WILDHATCH_SUPABASE_PUBLISHABLE_KEY=

# Devnet collectible minting. Use a private keypair file path locally.
# For Vercel, store the issuer keypair JSON as a server-only secret.
WILDHATCH_ISSUER_KEYPAIR_JSON=
